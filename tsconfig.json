{
  "compilerOptions": {
    "target": "ES2025",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "removeComments": true,
    "ignoreDeprecations": "6.0",
    "types": ["*"]
  },
  "include": [
    "./src/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
