{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "ignoreDeprecations": "6.0",
    "outDir": "../dist",
    "declaration": true,
    "stripInternal": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "../node_modules"
  ]
}
